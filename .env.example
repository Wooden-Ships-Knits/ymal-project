# YMAL — environment template.
#
# Copy to .env and fill in. .env is gitignored and must never be committed;
# this file is the record of WHAT is needed, never of what the values are.
#
# One .env serves both purposes:
#   - the Python pipeline reads it directly (ymal/auth.py)
#   - docker compose reads it for ${...} interpolation AND passes it into
#     containers via env_file, because it sits beside docker-compose.yml

# ---- Shopify (already in use)
# From the custom app in the Shopify admin. The backend exchanges these for an
# Admin API token; they never reach the browser.
SHOPIFY_CLIENT_ID=
SHOPIFY_SECRET_KEY=

# ---- Postgres (the event store, once analytics ships)
# Generate one:  openssl rand -base64 32
# No default in docker-compose.yml on purpose - compose fails loudly if this is
# unset rather than falling back to a password that is public in the repo.
POSTGRES_PASSWORD=
# Optional, both default to "ymal"
# POSTGRES_DB=ymal
# POSTGRES_USER=ymal

# Guards every write to the console API. The API refuses to start without it.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
YMAL_API_TOKEN=

# Host port for the console. Override when another stack on the same VM
# already holds the default - wholesale-order-entry uses 8083.
YMAL_WEB_PORT=8083

# ------------------------------------------------------------------
# Storefront tracking
# ------------------------------------------------------------------
# Where the console and its API are published. The tracking health check
# probes THIS, unauthenticated, because it is the only path a shopper's
# browser can take - the VM's nginx and its basic auth included.
YMAL_PUBLIC_URL=https://ymal.pt-infashion.com

# The storefront's exact origin. Checked against the CORS allowlist by the
# health check. Note the hyphen: an earlier default said "woodenships.com",
# and that one missing character lost every tracking event.
YMAL_SHOP_ORIGIN=https://www.wooden-ships.com

# Which origins may post events. Comma-separated, never a wildcard - any page
# on the internet could otherwise post into this shop's analytics.
YMAL_STOREFRONT_ORIGINS=https://www.wooden-ships.com,https://wooden-ships.com
