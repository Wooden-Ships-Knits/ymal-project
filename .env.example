# YMAL — environment template.
#
# Copy to .env and fill in. .env is gitignored and must never be committed;
# this file is the record of WHAT is needed, never of what the values are.
#
# One .env serves both purposes:
#   - the Python pipeline reads it directly (ymal/auth.py)
#   - docker compose reads it for ${...} interpolation AND passes it into
#     containers via env_file, because it sits beside docker-compose.yml

# ---- Shopify (already in use)
# From the custom app in the Shopify admin. The backend exchanges these for an
# Admin API token; they never reach the browser.
SHOPIFY_CLIENT_ID=
SHOPIFY_SECRET_KEY=

# ---- Postgres (the event store, once analytics ships)
# Generate one:  openssl rand -base64 32
# No default in docker-compose.yml on purpose - compose fails loudly if this is
# unset rather than falling back to a password that is public in the repo.
POSTGRES_PASSWORD=
# Optional, both default to "ymal"
# POSTGRES_DB=ymal
# POSTGRES_USER=ymal

# Guards every write to the console API. The API refuses to start without it.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
YMAL_API_TOKEN=
