{%- comment -%}
  YMAL — one recommendation block, placed from the theme editor.

  Add it the same way the web team adds a Wiser block: Add section -> YMAL
  Recommendations, then choose which block, the heading and the slot count.
  Wiser's appear under Apps because Wiser is an installed app shipping theme
  app extensions; this is a theme section, so it appears under Sections.

  Add it more than once for more than one block on a page.

  Where each block's list comes from:

    featured         product.metafields.ymal.featured   (this product's pool)
    trending         shop.metafields.ymal.trending
    top_selling      shop.metafields.ymal.top_selling
    new_arrivals     shop.metafields.ymal.new_arrivals
    recently_viewed  the shopper's own browser, no metafield at all

  All four metafields are list.product_reference, so Liquid gets the LIVE
  product - today's price, today's stock - from a list written at 03:00.

  Every card renders through snippets/ymal-card.liquid, which is the
  eligibility gate. An ineligible product renders nothing and is skipped, so a
  block can come out shorter than its slot count. That is correct: showing a
  fixed-stock or *SALE* product is the failure this project exists to prevent.
{%- endcomment -%}

{%- liquid
  assign block_id = section.settings.block
  assign slots = section.settings.slots | default: 6
  assign items = null

  case block_id
    when 'featured'
      assign items = product.metafields.ymal.featured.value
    when 'trending'
      assign items = shop.metafields.ymal.trending.value
    when 'top_selling'
      assign items = shop.metafields.ymal.top_selling.value
    when 'new_arrivals'
      assign items = shop.metafields.ymal.new_arrivals.value
  endcase
-%}

{%- if block_id == 'recently_viewed' -%}
  {%- comment -%} Rendered client-side; the snippet ships its own script. {%- endcomment -%}
  {%- render 'ymal-recently-viewed',
        page_type: section.settings.page_type,
        anchor: product,
        heading: section.settings.heading,
        slots: slots -%}

{%- else -%}
  {%- comment -%}
    Render the cards to a variable FIRST, then decide whether to draw the
    heading. A heading with nothing under it is worse than no block at all,
    and we cannot know the block is empty until the gate has run on every
    candidate.
  {%- endcomment -%}
  {%- capture ymal_cards -%}
    {%- assign shown = 0 -%}
    {%- for item in items -%}
      {%- if shown >= slots -%}{%- break -%}{%- endif -%}
      {%- comment -%} Never recommend the product being viewed. {%- endcomment -%}
      {%- if product != blank and item.id == product.id -%}{%- continue -%}{%- endif -%}

      {%- capture card -%}{%- render 'ymal-card', product: item, grid: section.settings.columns -%}{%- endcapture -%}
      {%- assign trimmed = card | strip -%}
      {%- unless trimmed == blank -%}
        <div class="ymal__card">{{ card }}</div>
        {%- assign shown = shown | plus: 1 -%}
      {%- endunless -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- assign has_cards = ymal_cards | strip -%}
  {%- if has_cards != blank -%}
    {%- comment -%}
      No theme wrapper classes. `.section` and `.container` mean different
      things in different themes - in this one they pushed the whole block to
      the right - so the section brings its own layout and inherits only type
      and colour.
    {%- endcomment -%}
    <div class="ymal ymal--{{ block_id }} ymal--{{ section.settings.layout }}"
      data-ymal-block="{{ block_id }}"
      data-ymal-page="{{ section.settings.page_type | escape }}"
    >
      {%- if section.settings.heading != blank -%}
        <h2 class="ymal__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <div class="ymal__viewport">
        <div class="ymal__grid">{{ ymal_cards }}</div>

        {%- if section.settings.layout == 'carousel' -%}
          {%- comment -%}
            Arrows are added by JS only if the row actually overflows - a block
            that fits needs no arrows, and drawing dead ones looks broken. The
            row scrolls natively either way, so this degrades to a swipeable
            strip if the script never runs.
          {%- endcomment -%}
          <button class="ymal__arrow ymal__arrow--prev" type="button"
                  aria-label="Previous products" hidden>
            {%- render 'icon-chevron-left', stroke_width: 1.3 -%}
          </button>
          <button class="ymal__arrow ymal__arrow--next" type="button"
                  aria-label="Next products" hidden>
            {%- render 'icon-chevron-right', stroke_width: 1.3 -%}
          </button>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
{%- endif -%}

{%- comment -%}
  Layout only. Everything inside a card is the theme's product-block, so this
  styles the row and nothing else.

  Scoped to this section's id: a page can carry more than one YMAL block, and
  they must not restyle each other or anything else on the page.

  The heading sets size, weight, alignment and spacing but NOT colour or
  family - those inherit, so the block follows the theme's typography settings
  and keeps following them when someone changes the palette.
{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} .ymal {
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
    {%- if section.settings.full_width -%}
      padding-inline: 0;
    {%- else -%}
      padding-inline: {{ section.settings.padding_inline }}px;
      max-width: {{ section.settings.max_width }}px;
      margin-inline: auto;
    {%- endif -%}
  }
  #shopify-section-{{ section.id }} .ymal__title {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    text-align: {{ section.settings.heading_align }};
    margin: 0 0 {{ section.settings.heading_gap }}px;
    line-height: 1.15;
  }
  #shopify-section-{{ section.id }} .ymal__viewport {
    position: relative;
  }

  {%- comment -%}
    Two defaults that break a card lifted out of the theme's own grid:

    `product-block` is a custom element, and an unknown element defaults to
    display:inline - which runs the title and price together on one line and
    lets the text flow out of the card.

    A flex or grid item defaults to min-width:auto, so a long product title
    pushes the card wider than its track instead of wrapping.

    The same inline default applies to the card's inner wrappers - the theme
    styles them from rules that assume its own product grid as an ancestor.
    Forcing them to block is what puts the price on its own line under the
    title rather than trailing after it.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .ymal__card {
    min-width: 0;
  }

  {%- comment -%}
    Lay the card out ourselves rather than relying on the theme's rules, which
    assume the card sits inside its own product grid. Stacked in a column:
    image, then title, then price, then the button - the same order the app
    block on this store uses.

    `!important` is deliberate and is confined to this section by the id
    prefix. The theme's own card styling is contextual and was winning in ways
    that put the price beside the title; overriding a handful of layout
    properties is more predictable than chasing each rule.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .ymal__card product-block,
  #shopify-section-{{ section.id }} .ymal__card .block-inner,
  #shopify-section-{{ section.id }} .ymal__card .block-inner-inner {
    display: block !important;
    width: 100% !important;
    float: none !important;
  }

  #shopify-section-{{ section.id }} .ymal__card .product-block__detail,
  #shopify-section-{{ section.id }} .ymal__card .product-block__detail .inner,
  #shopify-section-{{ section.id }} .ymal__card .product-block__detail .innerer,
  #shopify-section-{{ section.id }} .ymal__card .product-link {
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;
    width: 100% !important;
    float: none !important;
    gap: 4px;
  }

  #shopify-section-{{ section.id }} .ymal__card .product-block__title,
  #shopify-section-{{ section.id }} .ymal__card .product-price,
  #shopify-section-{{ section.id }} .ymal__card .product-price--block,
  #shopify-section-{{ section.id }} .ymal__card .vendor,
  #shopify-section-{{ section.id }} .ymal__card .product-block__subtitle {
    display: block !important;
    width: 100% !important;
    float: none !important;
    margin-inline: 0 !important;
  }

  {%- comment -%}
    The quick-buy button spans the card, the way the app block's "Choose
    Option" does.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .ymal__card .quickbuy-toggle.btn {
    display: block !important;
    width: 100% !important;
  }

  #shopify-section-{{ section.id }} .ymal__grid {
    display: grid;
    {%- if section.settings.card_width > 0 -%}
      grid-template-columns: repeat(auto-fill, {{ section.settings.card_width }}px);
      justify-content: center;
    {%- else -%}
      grid-template-columns: repeat({{ section.settings.columns }}, minmax(0, 1fr));
    {%- endif -%}
    gap: {{ section.settings.row_gap }}px {{ section.settings.column_gap }}px;
  }

  {%- comment -%}
    Carousel: one scrolling row of fixed-fraction cards, rather than a grid
    that wraps. Uses native scrolling with snap points, so it works by swipe,
    trackpad, keyboard and arrows alike, and needs no library.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .ymal--carousel .ymal__grid {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  #shopify-section-{{ section.id }} .ymal--carousel .ymal__grid::-webkit-scrollbar {
    display: none;
  }
  #shopify-section-{{ section.id }} .ymal--carousel .ymal__card {
    {%- if section.settings.card_width > 0 -%}
      /* Fixed card width, the way the app blocks on this store size theirs
         (236px with a 20px gap). Cards stay the same size whatever the screen,
         and more of them come into view rather than each one growing. */
      flex: 0 0 {{ section.settings.card_width }}px;
    {%- else -%}
      /* Auto: exactly `columns` cards fill the row, each one growing with the
         screen. */
      flex: 0 0 calc((100% - ({{ section.settings.columns | minus: 1 }} * {{ section.settings.column_gap }}px)) / {{ section.settings.columns }});
    {%- endif -%}
    scroll-snap-align: start;
  }

  #shopify-section-{{ section.id }} .ymal__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    cursor: pointer;
    background: rgba(255, 255, 255, .85);
    color: inherit;
  }
  #shopify-section-{{ section.id }} .ymal__arrow:hover {
    background: #fff;
  }
  #shopify-section-{{ section.id }} .ymal__arrow:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
  #shopify-section-{{ section.id }} .ymal__arrow--prev { left: 0; }
  #shopify-section-{{ section.id }} .ymal__arrow--next { right: 0; }
  #shopify-section-{{ section.id }} .ymal__arrow[hidden] { display: none; }

  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .ymal--grid .ymal__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 768px) {
    /* One scrolling row on a phone whichever layout is chosen - a tall stack
       is just something to scroll past. */
    #shopify-section-{{ section.id }} .ymal__grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }
    #shopify-section-{{ section.id }} .ymal__card {
      flex: 0 0 62%;
      scroll-snap-align: start;
    }
    #shopify-section-{{ section.id }} .ymal__title {
      font-size: {{ section.settings.heading_size | times: 0.7 | round }}px;
    }
    #shopify-section-{{ section.id }} .ymal__arrow { display: none; }
  }
</style>

{%- if section.settings.layout == 'carousel' -%}
<script>
  (function () {
    var root = document.getElementById("shopify-section-{{ section.id }}");
    if (!root) return;
    var row = root.querySelector(".ymal__grid");
    var prev = root.querySelector(".ymal__arrow--prev");
    var next = root.querySelector(".ymal__arrow--next");
    if (!row || !prev || !next) return;

    function step() {
      var card = row.querySelector(".ymal__card");
      return card ? card.getBoundingClientRect().width + {{ section.settings.column_gap }} : row.clientWidth;
    }

    function sync() {
      // Arrows appear only when there is somewhere to go. A row that fits
      // needs none, and a dead arrow reads as broken.
      var overflows = row.scrollWidth > row.clientWidth + 4;
      prev.hidden = !overflows || row.scrollLeft <= 4;
      next.hidden = !overflows || row.scrollLeft >= row.scrollWidth - row.clientWidth - 4;
    }

    prev.addEventListener("click", function () {
      row.scrollBy({ left: -step(), behavior: "smooth" });
    });
    next.addEventListener("click", function () {
      row.scrollBy({ left: step(), behavior: "smooth" });
    });

    row.addEventListener("scroll", sync, { passive: true });
    window.addEventListener("resize", sync);
    // Images load late and change scrollWidth, so re-check once they have.
    window.addEventListener("load", sync);
    sync();
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "YMAL Recommendations",
  "tag": "section",
  "class": "ymal-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "block",
      "label": "Block",
      "default": "featured",
      "info": "Featured needs a product to be about, so it only works on a product page.",
      "options": [
        {
          "value": "featured",
          "label": "Featured Products"
        },
        {
          "value": "trending",
          "label": "Trending Products"
        },
        {
          "value": "top_selling",
          "label": "Top Selling"
        },
        {
          "value": "new_arrivals",
          "label": "New Arrivals"
        },
        {
          "value": "recently_viewed",
          "label": "Recently Viewed"
        }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You May Also Like"
    },
    {
      "type": "range",
      "id": "slots",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6,
      "info": "Fewer may appear: sold-out, markdown and fixed-stock products are filtered out at render."
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "info": "Phones always show one scrolling row."
    },
    {
      "type": "select",
      "id": "page_type",
      "label": "Page type",
      "default": "product",
      "info": "Used for tracking, so Analytics can group by page.",
      "options": [
        {
          "value": "product",
          "label": "Product"
        },
        {
          "value": "home",
          "label": "Home"
        },
        {
          "value": "cart",
          "label": "Cart"
        },
        {
          "value": "collection",
          "label": "Collection"
        },
        {
          "value": "search",
          "label": "Search"
        },
        {
          "value": "not_found",
          "label": "404"
        },
        {
          "value": "blog",
          "label": "Blog"
        },
        {
          "value": "account",
          "label": "Account"
        },
        {
          "value": "thank_you",
          "label": "Thank you"
        }
      ]
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 64,
      "step": 2,
      "default": 40,
      "unit": "px",
      "info": "Colour and typeface follow your theme settings."
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "default": "300",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "600",
          "label": "Bold"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_gap",
      "label": "Space below heading",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "carousel",
      "info": "Carousel matches the app blocks already on this store.",
      "options": [
        {
          "value": "carousel",
          "label": "Carousel with arrows"
        },
        {
          "value": "grid",
          "label": "Grid that wraps"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true,
      "info": "Edge to edge, ignoring maximum width and side padding."
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 800,
      "max": 2000,
      "step": 40,
      "default": 1400,
      "unit": "px",
      "info": "Match your theme's other sections."
    },
    {
      "type": "range",
      "id": "padding_inline",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card width",
      "min": 0,
      "max": 400,
      "step": 4,
      "default": 0,
      "unit": "px",
      "info": "0 means cards stretch to fill the columns. The app blocks on this store use 236."
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Gap between columns",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Gap between rows",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 40,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "YMAL Recommendations"
    }
  ]
}
{% endschema %}
