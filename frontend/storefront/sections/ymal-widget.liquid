{%- comment -%}
  YMAL — one recommendation block, placed from the theme editor.

  Add it the same way the web team adds a Wiser block: Add section -> YMAL
  Recommendations, then choose which block, the heading and the slot count.
  Wiser's appear under Apps because Wiser is an installed app shipping theme
  app extensions; this is a theme section, so it appears under Sections.

  Add it more than once for more than one block on a page.

  Where each block's list comes from:

    featured         product.metafields.ymal.featured   (this product's pool)
    trending         shop.metafields.ymal.trending
    top_selling      shop.metafields.ymal.top_selling
    new_arrivals     shop.metafields.ymal.new_arrivals
    recently_viewed  the shopper's own browser, no metafield at all

  All four metafields are list.product_reference, so Liquid gets the LIVE
  product - today's price, today's stock - from a list written at 03:00.

  Every card renders through snippets/ymal-card.liquid, which is the
  eligibility gate. An ineligible product renders nothing and is skipped, so a
  block can come out shorter than its slot count. That is correct: showing a
  fixed-stock or *SALE* product is the failure this project exists to prevent.
{%- endcomment -%}

{%- liquid
  assign block_id = section.settings.block
  assign slots = section.settings.slots | default: 6
  assign items = null

  case block_id
    when 'featured'
      assign items = product.metafields.ymal.featured.value
    when 'trending'
      assign items = shop.metafields.ymal.trending.value
    when 'top_selling'
      assign items = shop.metafields.ymal.top_selling.value
    when 'new_arrivals'
      assign items = shop.metafields.ymal.new_arrivals.value
  endcase
-%}

{%- if block_id == 'recently_viewed' -%}
  {%- comment -%} Rendered client-side; the snippet ships its own script. {%- endcomment -%}
  {%- render 'ymal-recently-viewed',
        page_type: section.settings.page_type,
        anchor: product,
        heading: section.settings.heading,
        slots: slots -%}

{%- else -%}
  {%- comment -%}
    Render the cards to a variable FIRST, then decide whether to draw the
    heading. A heading with nothing under it is worse than no block at all,
    and we cannot know the block is empty until the gate has run on every
    candidate.
  {%- endcomment -%}
  {%- capture ymal_cards -%}
    {%- assign shown = 0 -%}
    {%- for item in items -%}
      {%- if shown >= slots -%}{%- break -%}{%- endif -%}
      {%- comment -%} Never recommend the product being viewed. {%- endcomment -%}
      {%- if product != blank and item.id == product.id -%}{%- continue -%}{%- endif -%}

      {%- capture card -%}{%- render 'ymal-card', product: item, grid: section.settings.columns -%}{%- endcapture -%}
      {%- assign trimmed = card | strip -%}
      {%- unless trimmed == blank -%}
        <div class="ymal__card">{{ card }}</div>
        {%- assign shown = shown | plus: 1 -%}
      {%- endunless -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- assign has_cards = ymal_cards | strip -%}
  {%- if has_cards != blank -%}
    <div class="section ymal ymal--{{ block_id }}"
      data-ymal-block="{{ block_id }}"
      data-ymal-page="{{ section.settings.page_type | escape }}"
    >
      <div class="container">
        {%- if section.settings.heading != blank -%}
          <h2 class="ymal__title h3">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        <div class="ymal__grid">{{ ymal_cards }}</div>
      </div>
    </div>
  {%- endif -%}
{%- endif -%}

{%- comment -%}
  Layout only. Everything inside a card is the theme's product-block, so this
  styles the row and nothing else.

  Scoped to this section's id: a page can carry more than one YMAL block, and
  they must not restyle each other or anything else on the page.
{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} .ymal__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, minmax(0, 1fr));
    gap: 2rem 1.5rem;
  }
  #shopify-section-{{ section.id }} .ymal__title {
    margin-bottom: 1.5rem;
  }
  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .ymal__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .ymal__grid {
      /* One scrolling row on a phone rather than a tall stack the shopper has
         to scroll past. Matches how the theme's own product rows behave. */
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      margin-inline: -1rem;
      padding-inline: 1rem;
    }
    #shopify-section-{{ section.id }} .ymal__card {
      flex: 0 0 62%;
      scroll-snap-align: start;
    }
  }
</style>

{% schema %}
{
  "name": "YMAL Recommendations",
  "tag": "section",
  "class": "ymal-section",
  "settings": [
    {
      "type": "select",
      "id": "block",
      "label": "Block",
      "default": "featured",
      "info": "Featured needs a product to be about, so it only works on a product page.",
      "options": [
        { "value": "featured", "label": "Featured Products" },
        { "value": "trending", "label": "Trending Products" },
        { "value": "top_selling", "label": "Top Selling" },
        { "value": "new_arrivals", "label": "New Arrivals" },
        { "value": "recently_viewed", "label": "Recently Viewed" }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You May Also Like"
    },
    {
      "type": "range",
      "id": "slots",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6,
      "info": "Fewer may appear: sold-out, markdown and fixed-stock products are filtered out at render."
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "info": "Phones always show one scrolling row."
    },
    {
      "type": "select",
      "id": "page_type",
      "label": "Page type",
      "default": "product",
      "info": "Used for tracking, so Analytics can group by page.",
      "options": [
        { "value": "product", "label": "Product" },
        { "value": "home", "label": "Home" },
        { "value": "cart", "label": "Cart" },
        { "value": "collection", "label": "Collection" },
        { "value": "search", "label": "Search" },
        { "value": "not_found", "label": "404" },
        { "value": "blog", "label": "Blog" },
        { "value": "account", "label": "Account" },
        { "value": "thank_you", "label": "Thank you" }
      ]
    }
  ],
  "presets": [
    { "name": "YMAL Recommendations" }
  ]
}
{% endschema %}
